
# Clave secreta para firmar tokens JWT.
# Generar con: python scripts/generate_secret.py
SECRET_KEY=cambia-esto-por-una-clave-generada-con-scripts/generate_secret.py

# CORS: origenes permitidos (separados por comas).
# En desarrollo: dejar vacio para permitir localhost.
# En produccion: definir explicitamente.
CORS_ALLOWED_ORIGINS=

# Base de datos (MySQL)
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mugly_db
DB_CHARSET=utf8mb4
